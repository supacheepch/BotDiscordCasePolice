x":456,"length":704,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1160,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1180,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1181,"length":16,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1197,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1199,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1210,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1211,"length":12,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1223,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1224,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965744,"raisedBackground":4294965744,"additiveBackground":566859077,"textPrimary":4281738506,"textSecondary":4285422138,"invertedBackground":4287586841,"overlayBackground":3426100490},"darkThemeColorPalette":{"baseBackground":4280029698,"raisedBackground":4281738506,"additiveBackground":734631237,"textPrimary":4294635744,"textSecondary":4292725420,"invertedBackground":4293115004,"overlayBackground":3426100490},"colorSampledDescriptionBodyText":{"content":"Produced by ‪@JakNatthaphon‬ \nCo Produce : Winner Chanatip\nAll Keyboard : Winner Chanatip\nAll Guitar : Pharada klinnak\nBass : ‪@patcharapong01‬ \nDrum edit \u0026 Sound Design : BOOSTER KHAOJANG\nMixed \u0026 Master : BOOSTER KHAOJANG @ Roller Studios  \n\nOriginal Track\n   • 【OFFICIAL MV】“พิง” [เพลงจากละครกระเช้าสีดา...  \n\nInstagram :   / fyeqoodgurl  \nSoundcloud :   / fyeqoodgurl  \nTwitter :   / fyeqoodgurl  \nFacebook :   / fyeqoodgurl  \ntiktok :   / fyeqoodgurl  \n___________________________________________________\n\n______________________\n\nตอนนี้ฝ้ายมีโปรเจคฟิล์มพิเศษชือ  ‘ Into the Blue ‘ by Fyeqoodgurl x Akirart \n\nฟิล์ม double exposure ที่จะพาคุณออกไปท่องเที่ยวแบบ one day trip กับ Fyeqoodgurl ผ่านการถ่ายภาพซ้อน\n\n“Taste of Freedom , Joy and Happiness”🌊\n\nออกค้นหาประสบการณ์และความรู้สึกใหม่ๆ ผ่านตัวฟิล์ม ‘Into the blue’ ได้แล้ววันนี้ \n\n📌📌ราคา 650 บาท\n\n✨พิเศษ\nสำหรับ 50 ออเดอร์แรก จะได้รับ \n1.ลายเซ็นของ Fyeqoodgurl \n2. ข้อความพิเศษจาก Fyeqoodgurl \n\nและ 100 ออเดอร์ถัดมา จะได้รับ\n1. ลายเซ็นของ Fyeqoodgurl \n______________________\n\n📍สามารถสั่งได้ที่ line: @akirart.minilab ลอตแรก 40 ม้วน พร้อมส่งวันจันทร์ หลังจากนั้นจะเป็นพรีออเดอร์นะคะ (5-7 วันจัดส่งค่ะ) \n\n#FyeqoodgurlXAkirart #IntotheBluefilm\n\n#Fyesumitta #Fyeqoodgurl #NontTanont","commandRuns":[{"startIndex":12,"length":16,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCUQsfcEGB4iEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/@JakNatthaphon","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCYiw3nYgB00A51hry8Npa2w","canonicalBaseUrl":"/@JakNatthaphon"}}},"loggingDirectives":{"trackingParams":"CCUQsfcEGB4iEwjV1vagl-GTAxULTzgFHbnrKb0="}},{"startIndex":126,"length":17,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCQQsfcEGB8iEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/@patcharapong01","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCUsfu0y5GkSvLtM2v7Yi1Tg","canonicalBaseUrl":"/@patcharapong01"}}},"loggingDirectives":{"trackingParams":"CCQQsfcEGB8iEwjV1vagl-GTAxULTzgFHbnrKb0="}},{"startIndex":258,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAYiEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=-tCPuOIeSHo","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{