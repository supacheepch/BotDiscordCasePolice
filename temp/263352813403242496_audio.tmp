กเลิก"}]},"accessibility":{"label":"ยกเลิก"},"trackingParams":"CKICEPBbIhMI1db2oJfhkwMVC084BR256ym9"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9"}},"showMoreText":{"simpleText":"...เพิ่มเติม"},"showLessText":{"simpleText":"แสดงน้อยลง"},"trackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Produced by ‪@JakNatthaphon‬ \nCo Produce : Winner Chanatip\nAll Keyboard : Winner Chanatip\nAll Guitar : Pharada klinnak\nBass : ‪@patcharapong01‬ \nDrum edit \u0026 Sound Design : BOOSTER KHAOJANG\nMixed \u0026 Master : BOOSTER KHAOJANG @ Roller Studios  \n\nOriginal Track\n   • 【OFFICIAL MV】“พิง” [เพลงจากละครกระเช้าสีดา...  \n\nInstagram :   / fyeqoodgurl  \nSoundcloud :   / fyeqoodgurl  \nTwitter :   / fyeqoodgurl  \nFacebook :   / fyeqoodgurl  \ntiktok :   / fyeqoodgurl  \n___________________________________________________\n\n______________________\n\nตอนนี้ฝ้ายมีโปรเจคฟิล์มพิเศษชือ  ‘ Into the Blue ‘ by Fyeqoodgurl x Akirart \n\nฟิล์ม double exposure ที่จะพาคุณออกไปท่องเที่ยวแบบ one day trip กับ Fyeqoodgurl ผ่านการถ่ายภาพซ้อน\n\n“Taste of Freedom , Joy and Happiness”🌊\n\nออกค้นหาประสบการณ์และความรู้สึกใหม่ๆ ผ่านตัวฟิล์ม ‘Into the blue’ ได้แล้ววันนี้ \n\n📌📌ราคา 650 บาท\n\n✨พิเศษ\nสำหรับ 50 ออเดอร์แรก จะได้รับ \n1.ลายเซ็นของ Fyeqoodgurl \n2. ข้อความพิเศษจาก Fyeqoodgurl \n\nและ 100 ออเดอร์ถัดมา จะได้รับ\n1. ลายเซ็นของ Fyeqoodgurl \n______________________\n\n📍สามารถสั่งได้ที่ line: @akirart.minilab ลอตแรก 40 ม้วน พร้อมส่งวันจันทร์ หลังจากนั้นจะเป็นพรีออเดอร์นะคะ (5-7 วันจัดส่งค่ะ) \n\n#FyeqoodgurlXAkirart #IntotheBluefilm\n\n#Fyesumitta #Fyeqoodgurl #NontTanont","commandRuns":[{"startIndex":12,"length":16,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJ8CELH3BBgaIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","commandMetadata":{"webCommandMetadata":{"url":"/@JakNatthaphon","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCYiw3nYgB00A51hry8Npa2w","canonicalBaseUrl":"/@JakNatthaphon"}}},"loggingDirectives":{"trackingParams":"CJ8CELH3BBgaIhMI1db2oJfhkwMVC084BR256ym9"}},{"startIndex":126,"length":17,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJ4CELH3BBgbIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","commandMetadata":{"webCommandMetadata":{"url":"/@patcharapong01","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCUsfu0y5GkSvLtM2v7Yi1Tg","canonicalBaseUrl":"/@patcharapong01"}}},"loggingDirectives":{"trackingParams":"CJ4CELH3BBgbIhMI1db2oJfhkwMVC084BR256ym9"}},{"startIndex":258,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJgCEM2rARgBIhMI1db2oJfhkwMVC084BR256ym9ygEEyYVf0Q==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=-tCPuOIeSHo","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"-tCPuOIeSHo","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr8---sn-5fo-c33ey.googlevideo.com/initpl