OLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965744,"raisedBackground":4294965744,"additiveBackground":566859077,"textPrimary":4281738506,"textSecondary":4285422138,"invertedBackground":4287586841,"overlayBackground":3426100490},"darkThemeColorPalette":{"baseBackground":4280029698,"raisedBackground":4281738506,"additiveBackground":734631237,"textPrimary":4294635744,"textSecondary":4292725420,"invertedBackground":4293115004,"overlayBackground":3426100490},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgstOUY0bExpRXl0dyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"1,653,952"},"label":{"simpleText":"ยอดดู"},"accessibilityText":"การดู 1,653,952 ครั้ง","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965744,"raisedBackground":4294965744,"additiveBackground":566859077,"textPrimary":4281738506,"textSecondary":4285422138,"invertedBackground":4287586841,"overlayBackground":3426100490},"darkThemeColorPalette":{"baseBackground":4280029698,"raisedBackground":4281738506,"additiveBackground":734631237,"textPrimary":4294635744,"textSecondary":4292725420,"invertedBackground":4293115004,"overlayBackground":3426100490},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2021"},"label":{"simpleText":"26 พ.ย."},"accessibilityText":"26 พ.ย. 2021","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965744,"raisedBackground":4294965744,"additiveBackground":566859077,"textPrimary":4281738506,"textSecondary":4285422138,"invertedBackground":4287586841,"overlayBackground":3426100490},"darkThemeColorPalette":{"baseBackground":4280029698,"raisedBackground":4281738506,"additiveBackground":734631237,"textPrimary":4294635744,"textSecondary":4292725420,"invertedBackground":4293115004,"overlayBackground":3426100490},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBUQ040EGAYiEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/@fyeqoodgurlofficial","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCqQ_OOh6zWczZWwkM48z5XA","canonicalBaseUrl":"/@fyeqoodgurlofficial"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/76sRRjqrMO-bBu0qGa7QW-kKuh2_krQqpI73pd6J2icQYUReUe_HMQvNrgs0ClY0WuuJJilIPw=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"แสดงเพิ่มเติม"}},"simpleText":"...เพิ่มเติม"},"showLessText":{"simpleText":"แสดงน้อยลง"},"attributedDescriptionBodyText":{"content":"Produced by ‪@JakNatthaphon‬ \nCo Produce : Winner Chanatip\nAll Keyboard : Winner Chanatip\nAll Guitar : Pharada klinnak\nBass : ‪@patcharapong01‬ \nDrum edit \u0026 Sound Design : BOOSTER KHAOJANG\nMixed \u0026 Master : BOOSTER KHAOJANG @ Roller Studios  \n\nOriginal Track\n   • 【OFFICIAL MV】“พิง” [เพลงจากละครกระเช้าสีดา...  \n\nInstagram :   / fyeqoodgurl  \nSoundcloud :   / fyeqoodgurl  \nTwitter :   / fyeqoodgurl  \nFacebook :   / fyeqoodgurl  \ntiktok :   / fyeqoodgurl  \n___________________________________________________\n\n______________________\n\nตอนนี้ฝ้ายมีโปรเจคฟิล์มพิเศษชือ  ‘ Into the Blue ‘ by Fyeqoodgurl x Akirart \n\nฟิล์ม double exposure ที่จะพาคุณออกไปท่องเที่ยวแบบ one day trip กับ Fyeqoodgurl ผ่านการถ่ายภาพซ้อน\n\n“Taste of Freedom , Joy and Happiness”🌊\n\nออกค้นหาประสบการณ์และความรู้สึกใหม่ๆ ผ่านตัวฟิล์ม ‘Into the blue’ ได้แล้ววันนี้ \n\n📌📌ราคา 650 บาท\n\n✨พิเศษ\nสำหรับ 50 ออเดอร์แรก จะได้รับ \n1.ลายเซ็นของ Fyeqoodgurl \n2. ข้อความพิเศษจาก Fyeqoodgurl \n\nและ 100 ออเดอร์ถัดมา จะได้รับ\n1. ลายเซ็นของ Fyeqoodgurl \n______________________\n\n📍สามารถสั่งได้ที่ line: @akirart.minilab ลอตแรก 40 ม้วน พร้อมส่งวันจันทร์ หลังจากนั้นจะเป็นพรีออเดอร์นะคะ (5-7 วันจัดส่งค่ะ) \n\n#FyeqoodgurlXAkirart #IntotheBluefilm\n\n#Fyesumitta #Fyeqoodgurl #NontTanont","commandRuns":[{"startIndex":12,"length":16,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCwQsfcEGFciEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/@JakNatthaphon","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCYiw3nYgB00A51hry8Npa2w","canonicalBaseUrl":"/@JakNatthaphon"}}},"loggingDirectives":{"trackingParams":"CCwQsfcEGFciEwjV1vagl-GTAxULTzgFHbnrKb0="}},{"startIndex":126,"length":17,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCsQsfcEGFgiEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/@patcharapong01","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCUsfu0y5GkSvLtM2v7Yi1Tg","canonicalBaseUrl":"/@patcharapong01"}}},"loggingDirectives":{"trackingParams":"CCsQsfcEGFgiEwjV1vagl-GTAxULTzgFHbnrKb0="}},{"startIndex":258,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAYiEwjV1vagl-GTAxULTzgFHbnrKb3KAQTJhV_R","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=-tCPuOIeSHo","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"-tCPuOIeSHo","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr8---sn-5fo-c33ey.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=fad08fb8e21e487a\u0026ip=2405%3A9800%3Ab660%3A2467%3A48b6%3A3e03%3A3aac%3Afb36\u0026initcwndbps=2615000\u0026mt=1775751469\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTc3NDM0OQ\u0026rxtags=Cg4KAnR4Egg1MTc3NDM0OQ%2CCg4KAnR4Egg1MTc3NDM1Mg"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: 【