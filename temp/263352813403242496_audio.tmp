r":{"spec":"https://i.ytimg.com/sb/-9F4lLiEytw/storyboard3_L$L/$N.jpg?sqp=-oaymwENSDfyq4qpAwVwAcABBqLzl_8DBgjBy5q3Bg==|48#27#100#10#10#0#default#rs$AOn4CLCq5B1ozcTXpB88LW46pslKLLpzrA|80#45#151#10#10#2000#M$M#rs$AOn4CLDEkMGQYk6ewl5rac89squZCzc3_w|160#90#151#5#5#2000#M$M#rs$AOn4CLB31ZyVoM43i2HZzh_erLbHKAV7DA|320#180#151#3#3#2000#M$M#rs$AOn4CLBQY_DEG-2GyGbU8251Yv9nXSMgnA","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/-9F4lLiEytw/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/-9F4lLiEytw","width":1280,"height":720},"title":{"simpleText":"พิง - Nont Tanont (Cover by Fyeqoodgurl)"},"description":{"simpleText":"Produced by @JakNatthaphon \nCo Produce : Winner Chanatip\nAll Keyboard : Winner Chanatip\nAll Guitar : Pharada klinnak\nBass : @patcharapong01 \nDrum edit \u0026 Sound Design : BOOSTER KHAOJANG\nMixed \u0026 Master : BOOSTER KHAOJANG @ Roller Studios  \n\nOriginal Track\nhttps://youtu.be/-tCPuOIeSHo\n\nInstagram : https://www.instagram.com/fyeqoodgurl\nSoundcloud : https://soundcloud.com/fyeqoodgurl\nTwitter : https://twitter.com/fyeqoodgurl\nFacebook : https://www.facebook.com/fyeqoodgurl\ntiktok : https://www.tiktok.com/@fyeqoodgurl\n___________________________________________________\n\n______________________\n\nตอนนี้ฝ้ายมีโปรเจคฟิล์มพิเศษชือ  ‘ Into the Blue ‘ by Fyeqoodgurl x Akirart \n\nฟิล์ม double exposure ที่จะพาคุณออกไปท่องเที่ยวแบบ one day trip กับ Fyeqoodgurl ผ่านการถ่ายภาพซ้อน\n\n“Taste of Freedom , Joy and Happiness”🌊\n\nออกค้นหาประสบการณ์และความรู้สึกใหม่ๆ ผ่านตัวฟิล์ม ‘Into the blue’ ได้แล้ววันนี้ \n\n📌📌ราคา 650 บาท\n\n✨พิเศษ\nสำหรับ 50 ออเดอร์แรก จะได้รับ \n1.ลายเซ็นของ Fyeqoodgurl \n2. ข้อความพิเศษจาก Fyeqoodgurl \n\nและ 100 ออเดอร์ถัดมา จะได้รับ\n1. ลายเซ็นของ Fyeqoodgurl \n______________________\n\n📍สามารถสั่งได้ที่ line: @akirart.minilab ลอตแรก 40 ม้วน พร้อมส่งวันจันทร์ หลังจากนั้นจะเป็นพรีออเดอร์นะคะ (5-7 วันจัดส่งค่ะ) \n\n#FyeqoodgurlXAkirart #IntotheBluefilm\n\n#Fyesumitta #Fyeqoodgurl #NontTanont"},"lengthSeconds":"299","ownerProfileUrl":"http://www.youtube.com/@fyeqoodgurlofficial","externalChannelId":"UCqQ_OOh6zWczZWwkM48z5XA","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GS","GT","GU","GW","GY","HK","HM","HN","HR","HT","HU","ID","IE","IL","IM","IN","IO","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG","KH","KI","KM","KN","KP","KR","KW","KY","KZ","LA","LB","LC","LI","LK","LR","LS","LT","LU","LV","LY","MA","MC","MD","ME","MF","MG","MH","MK","ML","MM","MN","MO","MP","MQ","MR","MS","MT","MU","MV","MW","MX","MY","MZ","NA","NC","NE","NF","NG","NI","NL","NO","NP","NR","NU","NZ","OM","PA","PE","PF","PG","PH","PK","PL","PM","PN","PR","PS","PT","PW","PY","QA","RE","RO","RS","RU","RW","SA","SB","SC","SD","SE","SG","SH","SI","SJ","SK","SL","SM","SN","SO","SR","SS","ST","SV","SX","SY","SZ","TC","TD","TF","TG","TH","TJ","TK","TL","TM","TN","TO","TR","TT","TV","TW","TZ","UA","UG","UM","US","UY","UZ","VA","VC","VE","VG","VI","VN","VU","WF","WS","YE","YT","ZA","ZM","ZW"],"isUnlisted":false,"hasYpcMetadata":false,"viewCount":"1653952","category":"Travel \u0026 Events","publishDate":"2021-11-26T01:00:00-08:00","ownerChannelName":"Fyeqoodgurl","uploadDate":"2021-11-26T01:00:00-08:00","isShortsEligible":false,"externalVideoId":"-9F4lLiEytw","likeCount":"23286","canonicalUrl":"https://www.youtube.com/watch?v=-9F4lLiEytw"}},"cards":{"cardCollectionRenderer":{"cards":[{"cardRenderer":{"tea